DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=career_ai_db
# Bat TLS khi dung MySQL Cloud (TiDB Cloud: true | Aiven khong kem CA: skip-verify)
DB_SSL=
# Tu dong tao bang & du lieu mau khi deploy lan dau len DB trong (true/false)
AUTO_INIT_DB=false
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=5
